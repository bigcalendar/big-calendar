{
  "name": "@big-calendar/tools-smoke-jest-cjs",
  "version": "0.0.0",
  "private": true,
  "description": "Smoke test: Jest in CommonJS mode (as next/jest uses it) requires every package; needs --experimental-vm-modules for ESM-only packages (support matrix).",
  "type": "module",
  "scripts": {
    "smoke": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "devDependencies": {
    "@big-calendar/core": "workspace:*",
    "@big-calendar/interactions": "workspace:*",
    "@big-calendar/react": "workspace:*",
    "@big-calendar/react-ui": "workspace:*",
    "@big-calendar/temporal": "workspace:*",
    "@big-calendar/testing": "workspace:*",
    "jest": "30.5.2"
  },
  "nx": {
    "name": "tools-smoke-jest-cjs",
    "tags": [
      "layer:tooling"
    ],
    "targets": {
      "smoke": {
        "dependsOn": [
          "^build"
        ],
        "cache": false
      }
    }
  }
}
