{
  "name": "@big-calendar/tools-smoke-webpack",
  "version": "0.0.0",
  "private": true,
  "description": "Smoke test: webpack builds and runs an app using every package.",
  "type": "module",
  "scripts": {
    "smoke": "node build.mjs"
  },
  "devDependencies": {
    "@big-calendar/core": "workspace:*",
    "@big-calendar/interactions": "workspace:*",
    "@big-calendar/react": "workspace:*",
    "@big-calendar/react-ui": "workspace:*",
    "@big-calendar/temporal": "workspace:*",
    "@big-calendar/testing": "workspace:*",
    "webpack": "5.112.2"
  },
  "nx": {
    "name": "tools-smoke-webpack",
    "tags": [
      "layer:tooling"
    ],
    "targets": {
      "smoke": {
        "dependsOn": [
          "^build"
        ],
        "cache": false
      }
    }
  }
}
