{
  "name": "@big-calendar/tools-ci",
  "version": "0.0.0",
  "private": true,
  "description": "Small CI checks, such as the decision-entry check (agent toolset).",
  "type": "module",
  "scripts": {
    "test": "vitest run"
  },
  "nx": {
    "name": "tools-ci",
    "tags": [
      "layer:tooling"
    ],
    "targets": {
      "typecheck": {
        "command": "tsc -p tsconfig.json",
        "options": {
          "cwd": "{projectRoot}"
        },
        "cache": true
      }
    }
  }
}
